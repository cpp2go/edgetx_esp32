# ESP32-P4 host: external ESP32-C5 co-processor for WiFi + Bluetooth (esp_hosted)

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# PSRAM (16-line HEX mode on P4)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# esp_wifi_remote: slave = ESP32-C5 (this board's companion chip is a C5)
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# esp_hosted: co-processor ESP32-C5 (SDIO to C5)
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y

# Put the ESP-Hosted SDIO transport mempool into PSRAM (DMA-reachable via cache
# on ESP32-P4). The default places it in internal DMA RAM as one contiguous
# ~48KB block; with EdgeTX/LVGL using the scarce internal SRAM this fails at
# boot with "HS_MP: mempool create failed: no mem" / assert in sdio_drv.c.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Uncomment if using ESP32-P4-Function-EV-Board (on-board C6 over SDIO):
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# WiFi remote buffer tuning
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y

# Bluetooth HCI from C5 via esp_hosted (NimBLE host on P4)
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_LEGACY_VHCI_ENABLE=y

# --- OpenX1 MIPI-DSI display (ST7102 480x800, ESP32-P4) ---
# Override the common (S3) ILI9488 MCU-bus display with the MIPI-DSI driver.
# CONFIG_LV_PREDEFINED_DISPLAY_OPENX1 is not set
CONFIG_LV_PREDEFINED_DISPLAY_NONE=y
CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_ST7102=y
# CONFIG_LV_TFT_DISPLAY_CONTROLLER_ILI9488 is not set
# CONFIG_LV_TFT_DISPLAY_PROTOCOL_MCU is not set
CONFIG_LV_TFT_DISPLAY_PROTOCOL_DSI=y

# DSI bus (2 lanes @ 820 Mbps; OSPTEK verified value for this module - a
# 500 Mbps config drives the LP escape clock above the 20 MHz spec limit and
# makes the panel stop ACKing DCS commands, hanging the DSI host)
CONFIG_LV_TFT_DSI_LANE_NUM=2
CONFIG_LV_TFT_DSI_LANE_BITRATE_MBPS=820
# The OSPTEK 4.3" 480x800 module is mounted landscape: UI is 800x480 and the
# flushed frames are rotated in software (DPI stays at native 480x800).
CONFIG_LV_TFT_DSI_UI_ROTATE_90=y

# DSI PHY power (internal LDO, 2.5V for VDD_MIPI_DPHY)
CONFIG_LV_TFT_DSI_PHY_LDO_CHAN=3
CONFIG_LV_TFT_DSI_PHY_LDO_VOLTAGE_MV=2500
CONFIG_LV_TFT_DSI_PANEL_RST_NUM=-1

# DPI video timing (480x800 @ ~60 Hz, OSPTEK ST7102 4.3" module)
CONFIG_LV_TFT_DSI_DPI_CLK_MHZ=38
CONFIG_LV_TFT_DSI_H_RES=480
CONFIG_LV_TFT_DSI_V_RES=800
CONFIG_LV_TFT_DSI_HSYNC=2
CONFIG_LV_TFT_DSI_HBP=40
CONFIG_LV_TFT_DSI_HFP=40
CONFIG_LV_TFT_DSI_VSYNC=2
CONFIG_LV_TFT_DSI_VBP=10
CONFIG_LV_TFT_DSI_VFP=310

# Touch: ST7123 over I2C (own bus on GPIO7/8, see board.h) - overrides the
# common S3 FT6x06/I2C config above.
# CONFIG_LV_TOUCH_CONTROLLER_FT6X06 is not set
CONFIG_LV_TOUCH_CONTROLLER_ST7123=y
CONFIG_LV_I2C_TOUCH=y
# CONFIG_LV_FT6X36_SWAPXY is not set
# CONFIG_LV_FT6X36_INVERT_Y is not set
# CONFIG_LV_ST7123_SWAPXY is not set
# CONFIG_LV_ST7123_INVERT_X is not set
# CONFIG_LV_ST7123_INVERT_Y is not set
CONFIG_LV_I2C=y

# --- TinyUSB (USB HID joystick / MSC / CDC) ---
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=y
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Espressif Systems"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Espressif Device"
CONFIG_TINYUSB_DESC_SERIAL_STRING="123456"
CONFIG_TINYUSB_DESC_CDC_STRING="Espressif CDC Device"
CONFIG_TINYUSB_DESC_MSC_STRING="Espressif MSC Device"

# IDF FatFs fixed 512-byte sector (EdgeTX sdcard.cpp requires FF_MAX_SS==FF_MIN_SS)
CONFIG_FATFS_SECTOR_512=y
# CONFIG_FATFS_SECTOR_4096 is not set
CONFIG_WL_SECTOR_SIZE_512=y
# CONFIG_WL_SECTOR_SIZE_4096 is not set

# --- ESP32-P4 silicon revision ---
# The OpenX1 board uses ESP32-P4 silicon rev v1.3. ESP-IDF v6.x defaults to the
# mutually-exclusive rev >=3.0 line (min v3.1), which cannot run on rev <3.0
# silicon. Opt into the "revisions <3.0" line (min v1.0 / max v1.99) instead.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# In the "revisions <3.0" line the CPLL is kept at 360 MHz; 400 MHz is only
# reachable on rev >=3.0 silicon. 360 MHz is the maximum supported here.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

